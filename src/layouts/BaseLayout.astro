---
import '../styles/global.css'
import { business } from '../data/site'

interface Props {
  title: string
  description: string
  current?: 'inicio' | 'carta'
}

const { title, description, current = 'inicio' } = Astro.props
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: `${business.name} ${business.locationName}`,
  description: business.description,
  telephone: '+34613996916',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'CC. La Monacilla, Av. de Montes de León, locales 13–14–15',
    postalCode: '21110',
    addressLocality: 'Aljaraque',
    addressRegion: 'Huelva',
    addressCountry: 'ES',
  },
  openingHours: 'Mo-Su 08:00-20:00',
  sameAs: [business.instagramUrl, business.mapsUrl],
  servesCuisine: ['Desayunos', 'Brunch', 'Cafetería', 'Comida mediterránea'],
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#aa2f24" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Canela y Miel, inicio">
        <span class="brand-main">Canela <em>y</em> Miel</span>
        <span class="brand-place">La Monacilla</span>
      </a>
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="/" aria-current={current === 'inicio' ? 'page' : undefined}>Inicio</a>
        <a href="/carta/" aria-current={current === 'carta' ? 'page' : undefined}>La carta</a>
        <a href={`${current === 'inicio' ? '' : '/'}#visitanos`}>Visítanos</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <a class="brand brand--light" href="/">
          <span class="brand-main">Canela <em>y</em> Miel</span>
          <span class="brand-place">La Monacilla</span>
        </a>
        <p>Buena comida.<br />Buen día. Buena vida.</p>
      </div>
      <div class="footer-links">
        <a href="/carta/">Carta</a>
        <a href={business.phoneHref}>Llamar</a>
        <a href={business.mapsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
        <a href={business.instagramUrl} target="_blank" rel="noreferrer">Instagram</a>
      </div>
      <p class="footer-note">© 2026 Canela y Miel · La Monacilla</p>
    </footer>
    <nav class="mobile-actions" aria-label="Acciones rápidas">
      <a href="/carta/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v16l-7-3-7 3V4a1 1 0 0 1 1-1Z"/><path d="M8 7h8M8 11h6"/></svg>
        Carta
      </a>
      <a href={business.phoneHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
        Llamar
      </a>
      <a href={business.mapsUrl} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        Cómo llegar
      </a>
    </nav>
  </body>
</html>
