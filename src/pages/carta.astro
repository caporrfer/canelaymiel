---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import menuHero from '../assets/photos/breakfast-board.jpg'
import eggs from '../assets/photos/hero-eggs.jpg'
import bakery from '../assets/photos/local-bakery.jpg'
import { business, menuSections } from '../data/site'
---

<BaseLayout
  title="La carta · Canela y Miel La Monacilla"
  description="Consulta la carta de desayunos, brunch, café y dulces de Canela y Miel La Monacilla."
  current="carta"
>
  <main id="contenido" class="menu-page">
    <section class="menu-hero">
      <div>
        <p class="eyebrow">Desayuna a bocados grandes</p>
        <h1>Nuestra <em>carta.</em></h1>
        <p>Elige, mezcla, comparte. Aquí el desayuno se toma muy en serio.</p>
      </div>
      <Image src={menuHero} alt="Desayuno con croissant, salmón, aguacate y zumo" widths={[600, 900]} sizes="(max-width: 760px) 100vw, 42vw" loading="eager" />
    </section>

    <nav class="category-nav" aria-label="Categorías de la carta">
      {menuSections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>

    <div class="menu-photo-strip">
      <Image src={eggs} alt="Huevos poché sobre tostada" widths={[600, 900]} sizes="50vw" />
      <div><span>POACHED</span><span>& HAPPY</span></div>
      <Image src={bakery} alt="Mostrador de pan y bollería en Canela y Miel" widths={[600, 900]} sizes="50vw" />
    </div>

    <section class="menu-sections section">
      {menuSections.map((section, index) => (
        <article class="menu-section" id={section.id}>
          <header>
            <span class="section-index">0{index + 1}</span>
            <div><p class="eyebrow">{section.eyebrow}</p><h2>{section.title}</h2><p>{section.intro}</p></div>
          </header>
          <div class="product-grid">
            {section.products.map((product) => (
              <div class="product-row">
                <div><strong>{product.name}</strong>{product.note && <small>{product.note}</small>}</div>
                {product.price && <span class:list={{ supplement: product.price.startsWith('+') }}>{product.price}</span>}
              </div>
            ))}
          </div>
        </article>
      ))}
      <aside class="menu-notice">
        <strong>¿Alergias o intolerancias?</strong>
        <p>Pregunta al equipo antes de pedir. Confirma también la disponibilidad y los precios del día.</p>
      </aside>
    </section>

    <section class="menu-cta" id="visitanos">
      <p class="eyebrow">Ahora solo falta probarlo</p>
      <h2>¿Nos vemos <em>hoy?</em></h2>
      <p>{business.hours}</p>
      <div class="button-row">
        <a class="button button--cream" href={business.mapsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
        <a class="button button--outline" href={business.phoneHref}>Llamar al {business.phoneLabel}</a>
      </div>
    </section>
  </main>

</BaseLayout>
